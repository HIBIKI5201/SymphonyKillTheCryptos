:root {
}

.deck {
    background-color: rgba(0, 0, 0, 0);
}

.deck-focus {
    background-color: rgba(153, 153, 153, 0.1);
    border-left-color: rgba(255, 255, 255, 0.5);
    border-right-color: rgba(255, 255, 255, 0.5);
    border-top-color: rgba(255, 255, 255, 0.5);
    border-bottom-color: rgba(255, 255, 255, 0.5);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    transition-duration: 0.2s;
}

.own {
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    transition-duration: 0.2s;
}

.own-focus {
    background-color: rgba(153, 153, 153, 0.1);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.5);
    border-right-color: rgba(255, 255, 255, 0.5);
    border-top-color: rgba(255, 255, 255, 0.5);
    border-bottom-color: rgba(255, 255, 255, 0.5);
    transition-duration: 0.2s;
}

.left-area-disabled {
    display: none;
}

/* デッキエリアの選択中カードハイライト */
.deck-card-selected {
    border-left-color: rgba(255, 220, 50, 0.95);
    border-right-color: rgba(255, 220, 50, 0.95);
    border-top-color: rgba(255, 220, 50, 0.95);
    border-bottom-color: rgba(255, 220, 50, 0.95);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    scale: 1.1 1.1;
    transition-duration: 0.15s;
}

/* 所持カードエリアの選択中カードハイライト */
.own-card-selected {
    border-left-color: rgba(100, 200, 255, 0.95);
    border-right-color: rgba(100, 200, 255, 0.95);
    border-top-color: rgba(100, 200, 255, 0.95);
    border-bottom-color: rgba(100, 200, 255, 0.95);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    scale: 1.1 1.1;
    transition-duration: 0.15s;
}
